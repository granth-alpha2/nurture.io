{
  "name": "@landmarknav/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go",
    "start:tunnel": "expo start --go --tunnel",
    "start:dev": "expo start --dev-client",
    "start:web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/domain/navigation.test.ts src/domain/device-harness.test.ts",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "expo": "58.0.17",
    "expo-camera": "58.0.12",
    "expo-location": "58.0.3",
    "expo-speech": "58.0.0",
    "expo-speech-recognition": "3.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
